const dotTex=makeDotSoft();
class SpritePool{
 constructor(n,blending){
  this.items=[];
  for(let i=0;i<n;i++){
   const m=new THREE.SpriteMaterial({map:dotTex,transparent:true,depthWrite:false,blending,opacity:0});
   const s=new THREE.Sprite(m); s.visible=false; scene.add(s);
   this.items.push({s,life:0,max:1,vel:new THREE.Vector3(),size:1,grow:0});
  }
  this.idx=0;
 }
 spawn(pos,vel,life,size,color,grow){
  const it=this.items[this.idx]; this.idx=(this.idx+1)%this.items.length;
  it.s.visible=true; it.s.position.copy(pos); it.vel.copy(vel);
  it.life=it.max=life; it.size=size; it.grow=(grow===undefined)?1.6:grow;
  it.s.material.color.set(color); it.s.material.opacity=0.75;
  it.s.scale.set(size,size,1);
 }
 update(dt){
  for(const it of this.items){
   if(!it.s.visible) continue;
   it.life-=dt;
   if(it.life<=0){it.s.visible=false;continue;}
   it.s.position.addScaledVector(it.vel,dt);
   it.vel.multiplyScalar(1-dt*1.5);
   const k=1-it.life/it.max, sc=it.size*(1+it.grow*k);
   it.s.scale.set(sc,sc,1);
   it.s.material.opacity=0.7*(1-k);
  }
 }
}
