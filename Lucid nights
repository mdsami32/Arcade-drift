  this.bovGain.gain.cancelScheduledValues(t);
  this.bovGain.gain.setValueAtTime(0.20+Math.random()*0.08,t);
  this.bovGain.gain.exponentialRampToValueAtTime(0.001,t+0.42);
  this.bovFilt.frequency.cancelScheduledValues(t);
  this.bovFilt.frequency.setValueAtTime(3200,t);
