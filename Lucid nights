   this.bovSrc.connect(this.bovFilt); this.bovFilt.connect(this.bovGain); this.bovGain.connect(this.master);
   this.bovSrc.start();
   const wind=ctx.createBufferSource(); wind.buffer=buf; wind.loop=true;
   this.wFilt=ctx.createBiquadFilter(); this.wFilt.type='bandpass'; this.wFilt.frequency.value=480; this.wFilt.Q.value=0.6;
