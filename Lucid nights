  const src=this.ctx.createBufferSource(); src.buffer=this.noiseBuf;
  const f=this.ctx.createBiquadFilter(); f.type='highpass'; f.frequency.value=6500;
  const g=this.ctx.createGain(); g.gain.setValueAtTime(vol,t);
  g.gain.exponentialRampToValueAtTime(0.001,t+0.04);
  src.connect(f); f.connect(g); g.connect(this.music);
  src.start(t); src.stop(t+0.06);
 },
 rain(v){ if(!this.ok)return; this.rGain.gain.setTargetAtTime(v*0.12,this.ctx.currentTime,0.4); },
 thunder(){
  if(!this.ok) return; const t=this.ctx.currentTime;
  const src=this.ctx.createBufferSource(); src.buffer=this.noiseBuf; src.playbackRate.value=0.3;
  const f=this.ctx.createBiquadFilter(); f.type='lowpass'; f.frequency.value=180;
  const g=this.ctx.createGain(); g.gain.setValueAtTime(0.5,t);
  g.gain.exponentialRampToValueAtTime(0.001,t+1.6);
  src.connect(f); f.connect(g); g.connect(this.master); src.start(t); src.stop(t+1.7);
 },
 engine(rpm,th,spN){
  if(!this.ok) return;
  const t=this.ctx.currentTime;
  const rr=clamp(rpm,0,1.05);
  const f=34+Math.pow(rr,1.12)*150;
  const jit=1+Math.sin(t*7.3)*0.006+Math.sin(t*13.7)*0.004;
  this.oscA.frequency.setTargetAtTime(f*jit,t,0.02);
  this.oscB.frequency.setTargetAtTime(f*1.007,t,0.02);
  this.oscC.frequency.setTargetAtTime(f*0.5,t,0.02);
  this.oscD.frequency.setTargetAtTime(f*3.02,t,0.02);
  this.gD.gain.setTargetAtTime(0.10+rr*rr*0.55,t,0.05);
  const open=th*0.55+rr*0.45;
  this.eFilt.frequency.setTargetAtTime(220+open*open*3800+spN*500,t,0.045);
  let vol=0.055+rr*0.10+th*0.05;
  if(rr>0.985) vol*=(Math.sin(t*95)>0)?1:0.35;
  this.eGain.gain.setTargetAtTime(vol,t,0.03);
  this.iGain.gain.setTargetAtTime(0.02+th*0.075+rr*0.03,t,0.08);
  this.iFilt.frequency.setTargetAtTime(500+rr*1600,t,0.1);
  const sp=(th>0.5&&rr>0.25)?clamp((rr-0.2)/0.8,0,1):0;
  this.tGain.gain.setTargetAtTime(sp*0.028,t,0.15);
  this.tOsc.frequency.setTargetAtTime(900+sp*2400+rr*600,t,0.1);
  if(this._pth>0.5&&th<0.5&&this._prr>0.35) this.bov();
  if(th===0&&rr>0.4&&Math.random()<rr*0.10) this.pop(rr);
