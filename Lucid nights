<div class="hint">IF A LINE NUMBER IS SHOWN, COPY THE WHOLE PANEL TEXT WHEN REPORTING.</div></div></div>
<noscript><div style="position:fixed;inset:0;background:#04050a;color:#eef0f4;display:flex;align-items:center;justify-content:center;z-index:100;letter-spacing:.2em">JAVASCRIPT IS DISABLED</div></noscript>

<script>
window.BUILD='6';
window.__fatal=function(msg,err){
 var f=document.getElementById('fatal');if(!f)return;
 var out=String(msg), line=0, src='';
 try{
  if(err&&err.stack){
   var re=/:(\d+):(\d+)/g,m2;
   while((m2=re.exec(err.stack))){
    var n=parseInt(m2[1],10);
    if(n>5){line=n;break;}
   }
  }
 }catch(e){}
 if(line&&window.__OFF&&window.__gameSrc){
  var k=line-window.__OFF+2;
  var ls=window.__gameSrc.split('\n');
  if(k>=1&&k<ls.length) src='\n>> line '+k+' of game code: '+ls[k-1].trim().slice(0,160);
 }
 f.style.display='flex';
 document.getElementById('fatalHead').textContent='STARTUP ERROR · BUILD '+window.BUILD;
 document.getElementById('fatalMsg').textContent=out+(line?('  (file line '+line+')'):'')+src;
};
window.addEventListener('error',function(e){__fatal((e.message||'Script error'),e.error||e);});
window.addEventListener('unhandledrejection',function(e){__fatal('Async error: '+e.reason);});
</script>
