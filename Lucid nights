<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<title>LUCID NIGHTS — Grand Loop</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{ --ac:#ff4fa3; --ink:#eef0f4; --panel:rgba(8,10,16,.58); --line:rgba(255,255,255,.13); }
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#04050a}
body{font-family:'Space Grotesk',sans-serif;color:var(--ink)}
#app,#app canvas{position:fixed;inset:0;width:100%;height:100%;display:block;filter:contrast(1.045) saturate(1.05) brightness(1.02)}
.layer{position:fixed;inset:0;pointer-events:none;z-index:5}
#vignette{background:radial-gradient(120% 95% at 50% 42%, transparent 50%, rgba(1,2,6,.68) 100%)}
#grain{background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2"/><feColorMatrix type="saturate" values="0"/></filter><rect width="180" height="180" filter="url(%23n)" opacity="0.5"/></svg>');opacity:.07;animation:grain .9s steps(3) infinite}
@keyframes grain{0%{background-position:0 0}33%{background-position:-40px 25px}66%{background-position:30px -35px}100%{background-position:0 0}}
#scan{background:repeating-linear-gradient(0deg,rgba(0,0,0,.12) 0 1px,transparent 1px 3px);opacity:.22}
#streaks{background:repeating-conic-gradient(from 0deg at 50% 46%,transparent 0deg 7.4deg,rgba(210,230,255,.09) 7.4deg 8.1deg,transparent 8.1deg 16deg);
 -webkit-mask-image:radial-gradient(circle at 50% 46%,transparent 34%,#000 78%);mask-image:radial-gradient(circle at 50% 46%,transparent 34%,#000 78%);
 opacity:0;transition:opacity .25s}
#flash{background:#fff;opacity:0}
#flash.fade{transition:opacity .7s ease}
#hud{opacity:0;transition:opacity .5s}
#hud.on{opacity:1}
#topbar{position:fixed;top:16px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:16px;background:var(--panel);border:1px solid var(--line);padding:9px 20px;border-radius:3px;backdrop-filter:blur(8px);font-size:11px;letter-spacing:.18em;white-space:nowrap;z-index:6}
#topbar .lab{opacity:.5;margin-right:7px;font-size:9px}
#topbar b{font-weight:700;font-size:14px;letter-spacing:.05em;font-variant-numeric:tabular-nums}
#topbar .sep{width:1px;height:15px;background:var(--line)}
#zoneCard{position:fixed;top:19%;left:0;width:100%;text-align:center;opacity:0;z-index:6}
#zoneCard.show{animation:zone 3.2s ease forwards}
#zoneNum{font-size:11px;letter-spacing:.6em;opacity:.75;margin-bottom:10px}
#zoneName{font-family:Unbounded;font-weight:700;font-size:clamp(22px,3.4vw,40px);text-transform:uppercase}
#zoneCard.show #zoneName{animation:zoneName 3.2s ease forwards}
#zoneCard .rule{width:64px;height:1px;background:var(--line);margin:14px auto 0}
@keyframes zone{0%{opacity:0;transform:translateY(10px)}12%{opacity:1;transform:none}78%{opacity:1}100%{opacity:0}}
@keyframes zoneName{0%{letter-spacing:.5em}100%{letter-spacing:.2em}}
#countdown{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-family:Unbounded;font-weight:900;font-size:clamp(90px,16vw,180px);color:var(--ac);opacity:0;z-index:7;pointer-events:none}
#countdown.pop{animation:cd .84s ease forwards}
@keyframes cd{0%{opacity:0;transform:scale(1.55)}18%{opacity:1;transform:scale(1)}72%{opacity:1}100%{opacity:0;transform:scale(.94)}}
#speedBox{position:fixed;right:26px;bottom:22px;text-align:right;z-index:6}
#speedNum{font-family:Unbounded;font-weight:900;font-size:56px;line-height:1;font-variant-numeric:tabular-nums}
#speedBox .unit{font-size:10px;letter-spacing:.42em;opacity:.6;margin:3px 4px 12px 0}
#sRow{display:flex;justify-content:flex-end;align-items:center;gap:10px}
#gear{font-family:Unbounded;font-weight:700;font-size:14px;border:1px solid var(--line);padding:3px 9px;border-radius:3px;background:var(--panel);min-width:34px;text-align:center}
#rpm{width:200px;height:4px;background:rgba(255,255,255,.14);border-radius:2px;overflow:hidden}
#rpm i{display:block;height:100%;width:0;background:var(--ac)}
#rpm.hot i{background:#ff4b4b}
#nitro{width:200px;height:5px;margin:10px 0 0 auto;background:rgba(255,255,255,.12);border-radius:2px;overflow:hidden}
#nitro i{display:block;height:100%;width:0;background:#fff}
#nitroLab{font-size:8px;letter-spacing:.36em;opacity:.5;margin-top:6px}
#altLab{font-size:8px;letter-spacing:.36em;opacity:.5;margin-top:8px}
#driftPop{position:fixed;top:72px;left:50%;transform:translateX(-50%);font-family:Unbounded;font-weight:700;font-size:18px;color:var(--ac);letter-spacing:.14em;opacity:0;transition:opacity .25s;z-index:6}
#driftPop.on{opacity:1}
#driftPop small{font-size:9px;letter-spacing:.4em;opacity:.6;display:block;text-align:center;margin-bottom:4px}
#minimap{position:fixed;left:24px;bottom:24px;background:var(--panel);border:1px solid var(--line);border-radius:3px;backdrop-filter:blur(6px);z-index:6}
#toast{position:fixed;bottom:23%;left:50%;transform:translateX(-50%);background:var(--panel);border:1px solid var(--line);padding:10px 20px;font-size:11px;letter-spacing:.24em;opacity:0;transition:opacity .3s;border-radius:3px;z-index:6;white-space:nowrap}
#toast.on{opacity:1}
#wrongWay{position:fixed;top:29%;left:0;width:100%;text-align:center;font-family:Unbounded;font-weight:900;font-size:32px;color:#ff4b4b;letter-spacing:.3em;display:none;animation:blink .5s steps(2) infinite;z-index:6}
#wrongWay.on{display:block}
@keyframes blink{to{opacity:.2}}
#touchUI{position:fixed;inset:0;pointer-events:none;z-index:7;opacity:0;transition:opacity .4s;display:none}
html.touch #touchUI{display:block}
#touchUI.on{opacity:1}
#touchUI .tbtn{pointer-events:auto;position:absolute;width:58px;height:58px;border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(9,10,13,.45);color:var(--ink);font-family:'Space Grotesk',sans-serif;font-size:10px;letter-spacing:.06em;backdrop-filter:blur(4px);touch-action:none;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}
#touchUI .tbtn.act{border-color:var(--ac);background:rgba(255,255,255,.16)}
#tLeft{left:18px;bottom:34px}
#tRight{left:92px;bottom:34px}
#tReset{left:18px;bottom:106px;width:52px;height:32px;border-radius:16px}
#tCam{left:82px;bottom:106px;width:52px;height:32px;border-radius:16px}
#tGas{right:18px;bottom:34px;width:74px;height:74px;font-size:11px}
#tBrake{right:106px;bottom:34px}
#tDrift{right:18px;bottom:124px}
#tNitro{right:106px;bottom:124px}
#tPause{top:16px;right:62px;width:36px;height:36px;border-radius:8px}
html.touch #minimap{left:16px;bottom:auto;top:64px;transform:scale(.78);transform-origin:top left}
html.touch #speedBox{bottom:auto;top:64px;right:16px;transform:scale(.8);transform-origin:top right}
html.touch #topbar{transform:translateX(-50%) scale(.82);transform-origin:top center}
#rotate{display:none;position:fixed;inset:0;z-index:60;background:rgba(4,5,8,.94);align-items:center;justify-content:center;text-align:center;font-size:12px;letter-spacing:.3em;padding:0 30px}
@media (orientation:portrait) and (pointer:coarse){ #rotate{display:flex} }
.screen{position:fixed;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;pointer-events:auto;background:rgba(3,4,9,.5);backdrop-filter:blur(2px);z-index:10;text-align:center}
.screen.on{display:flex}
#title .brand{font-family:Unbounded;font-weight:900;font-size:clamp(56px,10vw,120px);letter-spacing:.04em;line-height:.95}
#title .brand span{color:var(--ac)}
#title .sub{margin-top:16px;font-size:11px;letter-spacing:.52em;opacity:.7;padding-left:.52em}
#title .route{margin-top:22px;font-size:10px;letter-spacing:.22em;opacity:.55;max-width:680px;line-height:2;padding:0 16px}
#title .ctrls{margin-top:22px;display:flex;gap:22px;flex-wrap:wrap;justify-content:center;font-size:10px;letter-spacing:.14em;opacity:.9;max-width:760px;padding:0 16px}
kbd{font-family:'Space Grotesk',sans-serif;border:1px solid rgba(255,255,255,.3);border-bottom-width:2px;padding:2px 7px;border-radius:3px;font-size:10px;letter-spacing:.06em;background:rgba(255,255,255,.06);margin:0 3px}
.btn{margin-top:30px;font-family:Unbounded;font-weight:700;font-size:12px;letter-spacing:.26em;padding:17px 46px;background:var(--ac);color:#0a0b0d;border:none;cursor:pointer;border-radius:2px;transition:background .15s,transform .15s}
.btn:hover{background:#fff;transform:translateY(-1px)}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid rgba(255,255,255,.35)}
.btn.ghost:hover{border-color:#fff;background:rgba(255,255,255,.06)}
#bestLine{margin-top:20px;font-size:11px;letter-spacing:.24em;opacity:.65}
#title .foot{position:absolute;bottom:22px;font-size:9px;letter-spacing:.3em;opacity:.4;padding:0 12px}
.panel{background:rgba(6,8,14,.86);border:1px solid var(--line);border-radius:4px;padding:34px 40px;width:min(560px,92vw);max-height:88vh;overflow:auto;backdrop-filter:blur(10px)}
.panel h2{font-family:Unbounded;font-weight:800;font-size:24px;letter-spacing:.2em;margin-bottom:6px}
#rPlace{font-family:Unbounded;font-weight:900;font-size:38px;color:var(--ac);margin:4px 0 2px}
#rStars{display:flex;gap:8px;margin:10px 0 4px}
#rStars svg{width:27px;height:27px}
#newBest{display:none;font-size:10px;letter-spacing:.3em;color:var(--ac);margin-top:6px}
#newBest.on{display:block}
.stats{display:grid;grid-template-columns:1fr auto;gap:9px 24px;margin:20px 0 4px;font-size:13px}
.stats .l{opacity:.5;letter-spacing:.2em;font-size:9px;align-self:center}
.stats .v{font-weight:700;text-align:right;font-variant-numeric:tabular-nums}
#rBoard{margin-top:16px;border-top:1px solid var(--line);padding-top:12px;font-size:12px;line-height:2;opacity:.9;text-align:left}
#rBoard .row{display:flex;justify-content:space-between}
#rBoard .you{color:var(--ac);font-weight:700}
.btnRow{display:flex;gap:12px;margin-top:26px;justify-content:center;flex-wrap:wrap}
.btnRow .btn{margin-top:0;padding:14px 30px}
.pbtn{display:block;width:250px;max-width:80vw;margin:9px auto 0}
.hint{margin-top:20px;font-size:10px;letter-spacing:.26em;opacity:.5}
#pauseCtrls{margin-top:18px;font-size:10px;letter-spacing:.14em;opacity:.7;line-height:2.2}
#muteBtn{position:fixed;top:16px;right:16px;width:36px;height:36px;background:var(--panel);border:1px solid var(--line);border-radius:3px;color:var(--ink);cursor:pointer;pointer-events:auto;display:flex;align-items:center;justify-content:center;z-index:20}
#muteBtn:hover{border-color:#fff}
#fallback,#fatal{display:none;position:fixed;inset:0;align-items:center;justify-content:center;z-index:99;background:rgba(3,4,6,.92)}
#fallback,#fatal .panel{text-align:center}
#fallback{font-size:13px;letter-spacing:.2em}
#fatalMsg{margin-top:14px;font-size:13px;line-height:1.8;opacity:.9;word-break:break-all;font-family:monospace;white-space:pre-wrap}
#fatal .hint{margin-top:18px}
</style>
</head>
<body>
<div id="app"></div>
<div class="layer" id="flash"></div>
<div class="layer" id="streaks"></div>
<div class="layer" id="vignette"></div>
<div class="layer" id="grain"></div>
<div class="layer" id="scan"></div>

<div id="hud">
  <div id="topbar">
    <span><span class="lab">LAP</span><b id="hLap">1/2</b></span><span class="sep"></span>
    <span><span class="lab">TIME</span><b id="hTime">00:00.00</b></span><span class="sep"></span>
    <span><span class="lab">GATE</span><b id="hGate">1/10</b></span><span class="sep"></span>
    <span><span class="lab">POS</span><b id="hPos">4/4</b></span>
