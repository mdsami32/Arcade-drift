  const g=this.ctx.createGain();
  g.gain.setValueAtTime(0.10+Math.random()*0.13,t);
  g.gain.exponentialRampToValueAtTime(0.001,t+0.05+Math.random()*0.07);
  src.connect(f); f.connect(g); g.connect(this.master);
  src.start(t); src.stop(t+0.2);
