    <div id="nitroLab">NITRO — HOLD SHIFT</div>
    <div id="altLab">ELEV +0 M</div>
  </div>
  <div id="toast"></div>
  <div id="wrongWay">WRONG WAY</div>
</div>
<div id="countdown"></div>

<div id="touchUI">
  <button class="tbtn" id="tLeft">&#9664;</button>
  <button class="tbtn" id="tRight">&#9654;</button>
  <button class="tbtn" id="tReset">RST</button>
  <button class="tbtn" id="tCam">CAM</button>
  <button class="tbtn" id="tGas">GAS</button>
  <button class="tbtn" id="tBrake">BRK</button>
  <button class="tbtn" id="tDrift">DRIFT</button>
  <button class="tbtn" id="tNitro">N2O</button>
  <button class="tbtn" id="tPause">II</button>
</div>

<div class="screen on" id="title">
  <div class="brand">LUCID <span>NIGHTS</span></div>
  <div class="sub">GRAND LOOP · MIDNIGHT PULSE</div>
  <div class="route">NOVA GRID BOULEVARD → SKYLINE FREEWAY → PIER SEVEN COAST → SUMMIT RIDGE CLIMB →
  THE UNDERPASS → DOCKYARD RUN → CRESTVIEW STREETS → HOME</div>
  <div class="ctrls">
    <span><kbd>W</kbd><kbd>S</kbd> DRIVE</span>
    <span><kbd>A</kbd><kbd>D</kbd> STEER</span>
    <span><kbd>SPACE</kbd> DRIFT</span>
    <span><kbd>SHIFT</kbd> NITRO</span>
    <span><kbd>R</kbd> RESET</span>
