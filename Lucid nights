/* ================= PHYSICS — UNCHANGED ================= */
function stepPlayer(dt){
 const locked=(state==='countdown');
 const th=inThrottle(), br=inBrake(), hb=inHB();
 const sp=Math.hypot(P.vx,P.vz);
 const maxSteer=0.66-0.49*clamp(sp/MAXV,0,1);
 const target=inSteer()*maxSteer;
 const rate=(Math.abs(target)>Math.abs(P.steer)?3.8:5.4);
 P.steer+=clamp(target-P.steer,-rate*dt,rate*dt);

 let f=new THREE.Vector2(Math.sin(P.h),Math.cos(P.h));
 let r=new THREE.Vector2(-f.y,f.x);
 let vF=P.vx*f.x+P.vz*f.y, vL=P.vx*r.x+P.vz*r.y;
 const eff=1-0.3*P.dmg/100;
 P.nitroOn=inNitro()&&P.nitro>0.01&&th>0&&state==='race';
 if(P.nitroOn) P.nitro=Math.max(0,P.nitro-0.3*dt);
 else if(state==='race') P.nitro=Math.min(1,P.nitro+0.02*dt);

 const vm=MAXV*eff*(P.nitroOn?1.18:1)*(P.offroad?0.72:1);
 if(locked){
  vF=0; vL=0;
 }else if(br>0&&vF<0.6&&th===0){
  P.mode='R';
  vF=Math.max(vF-7.5*br*dt,-REVV);
 }else{
  P.mode=vF<-0.3?'R':'D';
  if(th>0) vF+=ACC*eff*(P.nitroOn?1.6:1)*Math.max(0,1-vF/vm)*th*dt*(P.offroad?0.62:1);
  if(br>0) vF=Math.max(0,vF-BRAKE*(0.55+0.45*clamp(vF/vm,0,1))*br*dt);
  if(th===0&&br===0) vF=moveToward(vF,0,(0.7+(P.offroad?7:0))*dt);
  if(hb) vF=moveToward(vF,0,6.5*dt);
 }
 let yaw=-P.steer*(vF/WB)*0.95*(1-0.25*clamp(sp/MAXV,0,1));
 if(hb&&sp>8) yaw*=1.35;
 yaw=clamp(yaw,-1.65,1.65);
 P.h+=yaw*dt;
 P.vx=f.x*vF+r.x*vL; P.vz=f.y*vF+r.y*vL;
 f=new THREE.Vector2(Math.sin(P.h),Math.cos(P.h));
 r=new THREE.Vector2(-f.y,f.x);
 let vF2=P.vx*f.x+P.vz*f.y, vL2=P.vx*r.x+P.vz*r.y;
 let grip=7.2;
 if(hb) grip=1.6;
 else if(P.drifting&&th>0.4) grip=3.6;
 if(P.offroad) grip*=0.55;
 vL2*=Math.exp(-dt*grip);
 P.slip=Math.atan2(vL2,Math.max(2,Math.abs(vF2)));
 if(Math.abs(P.slip)>0.25) vF2*=Math.exp(-dt*0.4*Math.min(1,Math.abs(P.slip)));
 P.vx=f.x*vF2+r.x*vL2; P.vz=f.y*vF2+r.y*vL2;
 P.vF=vF2; P.vL=vL2;
 P.x+=P.vx*dt; P.z+=P.vz*dt;
 P.drifting=Math.abs(P.slip)>0.15&&sp>8;
 if(vF2<-0.3){ P.gear=1; P.rpm=clamp(Math.abs(vF2)/REVV,0.12,1); }
 else{
  if(P.shiftT>0) P.shiftT-=dt;
  const hi=GEARS[P.gear-1], lo=P.gear>1?GEARS[P.gear-2]*0.55:0;
  let rn=clamp((vF2-lo)/(hi-lo),0,1);
  if(vF2<1&&th>0) rn=Math.max(rn,th*0.85);
  if(rn>0.96&&P.gear<5&&P.shiftT<=0){P.gear++;P.shiftT=0.22;audio.shift();}
  else if(P.gear>1&&rn<0.26&&P.shiftT<=0){P.gear--;P.shiftT=0.18;}
  P.rpm=lerp(P.rpm,P.shiftT>0?rn*0.7:Math.max(rn,0.12),1-Math.exp(-dt*10));
 }
 let best=1e9,bi=P.pIdx;
 for(let o=-50;o<=50;o++){
  const i=(P.pIdx+o+N)%N, dx=P.x-SP[i].x, dz=P.z-SP[i].z, d2=dx*dx+dz*dz;
  if(d2<best){best=d2;bi=i;}
 }
 P.pIdx=bi; P.t=bi/N;
 P.lateral=(P.x-SP[bi].x)*SR[bi].x+(P.z-SP[bi].z)*SR[bi].z;
 P.offroad=Math.abs(P.lateral)>HW[bi]+0.7;
 carY=SY[bi];
 const ia=(bi+4)%N;
 carSlope=Math.atan2(SY[ia]-SY[bi],4*(L/N))*(P.vF>=0?1:-1);
 const accL=(vF2-(P._pvF||0))/Math.max(dt,0.001); P._pvF=vF2;
 P.pitch=damp(P.pitch,clamp(-accL*0.004,-0.05,0.07),6,dt);
 P.roll=damp(P.roll,clamp(-yaw*vF2*0.0032,-0.09,0.09),6,dt);
 brakeCur=damp(brakeCur,((br>0&&vF2>1)||(hb&&sp>4))?1:0,10,dt);
 if(P.drifting&&state==='race'){
  P.chain+=Math.abs(P.slip)*sp*dt*10; P.chainT=0.6;
 }else if(P.chainT>0){
  P.chainT-=dt;
  if(P.chainT<=0&&P.chain>40){
   driftTotal+=Math.round(P.chain);
   P.nitro=Math.min(1,P.nitro+P.chain*0.0004);
   P.chain=0;
  }
 }
 topSpeed=Math.max(topSpeed,sp*3.6);
 skidClock-=dt;
 const rearX=P.x-f.x*1.35, rearZ=P.z-f.y*1.35;
 if((P.drifting||(hb&&sp>4))&&!P.offroad){
  if(skidClock<=0){ skidClock=0.03;
   laySkid(rearX-r.x*0.8,carY,rearZ-r.y*0.8,P.h);
   laySkid(rearX+r.x*0.8,carY,rearZ+r.y*0.8,P.h);
  }
  if(Math.random()<0.6) smoke.spawn(new THREE.Vector3(rearX+rand(-0.8,0.8),carY+0.3,rearZ+rand(-0.8,0.8)),
   new THREE.Vector3(rand(-1,1),rand(1,2.2),rand(-1,1)),rand(0.5,0.9),rand(0.8,1.4),0xb8bcc4);
 }
 if(P.offroad&&sp>6&&Math.random()<0.5)
  smoke.spawn(new THREE.Vector3(rearX,carY+0.25,rearZ),new THREE.Vector3(rand(-1,1),rand(0.8,1.8),rand(-1,1)),rand(0.4,0.8),rand(0.9,1.5),0x8a8578);
 if(wet>0.4&&sp>12&&Math.random()<0.5)
  smoke.spawn(new THREE.Vector3(rearX+rand(-0.9,0.9),carY+0.2,rearZ+rand(-0.9,0.9)),
   new THREE.Vector3(rand(-1,1),rand(0.6,1.6),rand(-1,1)),rand(0.3,0.6),rand(0.7,1.2),0x8ca2ba,2.2);
 if(P.nitroOn&&Math.random()<0.8)
  sparks.spawn(new THREE.Vector3(P.x-f.x*2.2+rand(-0.45,0.45),carY+0.45,P.z-f.y*2.2),
   new THREE.Vector3(-f.x*4+rand(-1,1),rand(0,1),-f.y*4+rand(-1,1)),0.22,0.4,0x7ab8ff,0.4);
 if(P.dmg>55&&Math.random()<0.12)
  smoke.spawn(new THREE.Vector3(P.x+f.x*2,carY+0.85,P.z+f.y*2),new THREE.Vector3(rand(-0.4,0.4),rand(1.2,2),rand(-0.4,0.4)),0.9,0.7,0x4a4a50,2.2);
 const near=obstaclesNear(P.x,P.z);
 for(let q=0;q<near.length;q++){
  const o=obstacles[near[q]], dx=P.x-o.x, dz=P.z-o.z, rr=o.r+1.15, d2=dx*dx+dz*dz;
  if(d2<rr*rr&&d2>0.0001){
   const dd=Math.sqrt(d2), nx=dx/dd, nz=dz/dd;
   P.x=o.x+nx*rr; P.z=o.z+nz*rr;
   const vn=P.vx*nx+P.vz*nz;
   if(-vn>3.5){
    const imp=-vn;
    P.dmg=Math.min(100,P.dmg+imp*0.9);
    shake=Math.min(1,imp/22);
    audio.thud(imp);
    for(let s=0;s<8;s++) sparks.spawn(new THREE.Vector3(o.x+nx*o.r,carY+0.6,o.z+nz*o.r),
     new THREE.Vector3(nx*rand(2,6)+rand(-2,2),rand(1,4),nz*rand(2,6)+rand(-2,2)),rand(0.2,0.4),0.35,0xffd76a,0.3);
    if(P.dmg>50&&dmgToastStep<1){dmgToastStep=1;toast('HEAVY DAMAGE — PERFORMANCE REDUCED');}
    else if(P.dmg>88&&dmgToastStep<2){dmgToastStep=2;toast('CRITICAL CONDITION');}
   }
   if(vn<0){ P.vx-=nx*vn*1.6; P.vz-=nz*vn*1.6; P.vx*=0.82; P.vz*=0.82; }
  }
 }
 if(Math.abs(P.lateral)>90){ resetToGate(); toast('RETURNING TO THE ROUTE'); }
}

function stepProgress(){
 const fwdSpeed=P.vx*ST[P.pIdx].x+P.vz*ST[P.pIdx].z;
 const prev=P.prevT, cur=P.t;
 if(prev>0.85&&cur<0.15&&fwdSpeed>1){
  if(P.nextGate===10&&P.gatesPassed===9){
   P.lapsDone++;
   if(P.lapsDone>=2) return finishRace();
   toast('FINAL LAP'); audio.chime();
   lapTimes.push(raceTime-lapTimes.reduce((a,b)=>a+b,0));
  }else if(P.nextGate===10){
   toast('GATE MISSED — LAP NOT COUNTED');
  }
  P.lapFloat=Math.floor(P.lapFloat)+1+cur;
  P.nextGate=1; P.gatesPassed=0;
 }
 if(prev<0.15&&cur>0.85){
  P.lapFloat=Math.floor(P.lapFloat)-1+cur;
 }
 for(let k=P.nextGate;k<=9;k++){
  const gt=k/10;
  if(prev<gt&&cur>=gt&&fwdSpeed>1){
   P.gatesPassed++; P.nextGate=k+1;
   gates[k-1].mats[0].color.setHex(0x24262e);
   audio.chime();
  }
 }
 P.prevT=cur;
 if(fwdSpeed<-3&&Math.hypot(P.vx,P.vz)>4) wrongT+=1/60; else wrongT=Math.max(0,wrongT-1/30);
 $('wrongWay').classList.toggle('on',wrongT>1.2);
}
function playerMeters(){ return P.lapFloat*L; }
function finishRace(){
 state='finished'; finishT=0;
 lapTimes.push(raceTime-lapTimes.reduce((a,b)=>a+b,0));
 audio.count(true); flashScreen(0.2);
}

/* ================= AI ================= */
function stepAI(dt){
 const pm=playerMeters();
 for(const a of ais){
  const rub=1+clamp((pm-a.s)/900,-0.10,0.15);
  const tv=Math.min(a.vmax*rub*(1+0.03*Math.sin(time*0.7+a.phase)),
   Math.sqrt(a.aLat/Math.max(curvAtM(a.s+32),1e-4)));
  a.v+=clamp(tv-a.v,-24*dt,a.accel*dt);
  a.s+=a.v*dt;
  if(!a.finished&&a.s>=2*L){a.finished=true;a.time=raceTime;}
  const m=((a.s%L)+L)%L, i=Math.floor(m/L*N)%N;
  const lane=a.lane*clamp(HW[i]/8,0.7,1.3)+Math.sin(a.s*0.013+a.phase)*0.9;
  a.mesh.position.set(SP[i].x+SR[i].x*lane,SY[i],SP[i].z+SR[i].z*lane);
  a.mesh.rotation.y=Math.atan2(ST[i].x,ST[i].z);
  a.shadow.position.set(a.mesh.position.x,SY[i]+0.05,a.mesh.position.z);
  a.shadow.rotation.y=a.mesh.rotation.y;
  const dx=P.x-a.mesh.position.x, dz=P.z-a.mesh.position.z, d3=Math.hypot(dx,dz);
  if(d3<2.4&&d3>0.01){
   P.x+=dx/d3*(2.4-d3)*0.5; P.z+=dz/d3*(2.4-d3)*0.5;
   P.vx*=0.985; P.vz*=0.985;
  }
 }
}

/* ================= AUTOPILot (attract) ================= */
function autopilot(dt,crz){
 const look=posAtM(P.t*L+34);
 const ht=Math.atan2(look.x-P.x,look.z-P.z);
 const dh=wrapPI(ht-P.h);
 P.steer=clamp(-dh*1.6,-0.5,0.5);
 P.h-=P.steer*Math.min(crz,14)/WB*0.95*dt;
 const sp=crz;
 P.vx=Math.sin(P.h)*sp; P.vz=Math.cos(P.h)*sp;
 P.x+=P.vx*dt; P.z+=P.vz*dt;
 P.vF=sp;
 let best=1e9;
 for(let o=-60;o<=60;o++){
  const i=(P.pIdx+o+N)%N, dx=P.x-SP[i].x, dz=P.z-SP[i].z, d2=dx*dx+dz*dz;
  if(d2<best){best=d2;P.pIdx=i;}
 }
 P.t=P.pIdx/N;
 P.lateral=(P.x-SP[P.pIdx].x)*SR[P.pIdx].x+(P.z-SP[P.pIdx].z)*SR[P.pIdx].z;
 carY=SY[P.pIdx];
 P.rpm=lerp(P.rpm,0.35+0.1*Math.sin(time*2),0.1);
 P.gear=2;
}

/* ================= CAMERA ================= */
const camPos=new THREE.Vector3(), camLook=new THREE.Vector3();
function stepCamera(dt){
 const sp=Math.hypot(P.vx,P.vz), spN=clamp(sp/MAXV,0,1.2);
 const f=new THREE.Vector3(Math.sin(P.h),0,Math.cos(P.h));
 let targetFov;
 if(camMode===0&&state!=='title'){
  camPos.set(P.x,carY+1.26,P.z).addScaledVector(f,0.18);
  camera.position.copy(camPos);
  camera.rotation.order='YXZ';
  camera.rotation.y=P.h+Math.PI+rand(-1,1)*shake*0.012;
  camera.rotation.x=-0.015+P.pitch*0.6-carSlope*0.5+rand(-1,1)*shake*0.01;
  camera.rotation.z=P.roll*0.8+P.steer*0.03+clamp(-P.vL*0.004,-0.03,0.03)+rand(-1,1)*shake*0.008;
  targetFov=72+13*spN+(P.nitroOn?8:0);
  dash.visible=true; carMesh.visible=false;
 }else{
  const dist=state==='title'?9:6.2+sp*0.05, h=state==='title'?3.1:2.4;
  const sway=state==='title'?Math.sin(time*0.25)*2.4:0;
  camLat=damp(camLat,clamp(-P.vL*0.14,-2.4,2.4),4,dt);
  const r=new THREE.Vector3(-f.z,0,f.x);
  camPos.set(P.x,carY,P.z).addScaledVector(f,-dist).addScaledVector(r,sway+camLat);
  camPos.y=carY+h;
  camera.position.lerp(camPos,1-Math.exp(-dt*4));
  camLook.set(P.x,carY+1.15,P.z).addScaledVector(f,3);
  camera.lookAt(camLook);
  camera.rotation.z+=clamp(P.vL*0.006,-0.04,0.04);
  if(shake>0.01){ camera.rotation.z+=rand(-1,1)*shake*0.02; camera.rotation.x+=rand(-1,1)*shake*0.012; }
  targetFov=(state==='title'?58:66)+12*spN+(P.nitroOn?8:0);
  dash.visible=false; carMesh.visible=true;
 }
 camera.fov=damp(camera.fov,targetFov,5,dt); camera.updateProjectionMatrix();
 shake=Math.max(0,shake-dt*2.2);
 wheelGroup.rotation.z=-P.steer*2.4;
 dash.rotation.x=P.pitch*0.7; dash.rotation.z=P.roll*0.6;
 carMesh.position.set(P.x,carY,P.z);
 carMesh.rotation.y=P.h;
 carMesh.rotation.x=P.pitch+carSlope*0.55;
 carMesh.rotation.z=P.roll;
 const wheels=carMesh.userData.wheels;
 for(let i=0;i<wheels.length;i++){
  wheels[i].w.rotation.x+=P.vF*dt/0.34;
  if(wheels[i].front) wheels[i].pivot.rotation.y=-P.steer*0.9;
 }
 sky.position.copy(camera.position);
 stars.position.copy(camera.position);
 farGroup.position.set(camera.position.x,-20,camera.position.z);
}

/* ================= PALETTE MORPH ================= */
const PAL={skyTop:new THREE.Color(),skyHor:new THREE.Color(),glow:new THREE.Color(),fog:new THREE.Color(),
 hemiS:new THREE.Color(),hemiG:new THREE.Color(),moon:new THREE.Color(),
 accent:new THREE.Color(),edge:new THREE.Color()};
let domZone=-1;
const _b=new THREE.Color(), _pulseC=new THREE.Color(), _sunDir=new THREE.Vector3();
function stepPalette(dt){
 const k=zrAt(P.t), kr=ZR[k];
 const span=kr[1]-kr[0];
 const fr=(P.t-kr[0])/span;
 const w=fr>0.9?(fr-0.9)/0.1:0;
 const nk=(k+1)%ZR.length;
 const A=ZONES[kr[2]], B=ZONES[ZR[nk][2]];
 PAL.skyTop.lerpColors(A.cSkyTop,B.cSkyTop,w);
 PAL.skyHor.lerpColors(A.cSkyHor,B.cSkyHor,w);
 PAL.glow.lerpColors(A.cGlow,B.cGlow,w);
 PAL.fog.lerpColors(A.cFog,B.cFog,w);
 PAL.hemiS.lerpColors(A.cHemiS,B.cHemiS,w);
 PAL.hemiG.lerpColors(A.cHemiG,B.cHemiG,w);
 PAL.moon.lerpColors(A.cAccent,B.cAccent,w).lerp(_b.setHex(0xcfd8ff),0.8);
 PAL.accent.set(A.accent).lerp(_b.set(B.accent),w);
 PAL.edge.lerpColors(A.cEdge,B.cEdge,w);
 skyMat.uniforms.top.value.copy(PAL.skyTop);
 skyMat.uniforms.hor.value.copy(PAL.skyHor);
 skyMat.uniforms.glowCol.value.copy(PAL.glow);
 skyMat.uniforms.moonCol.value.copy(PAL.moon);
 const el=lerp(A.moonEl,B.moonEl,w), az=lerp(A.moonAz,B.moonAz,w), sr=lerp(A.moonSize,B.moonSize,w);
 _sunDir.set(Math.cos(el)*Math.sin(az),Math.sin(el),Math.cos(el)*Math.cos(az));
 skyMat.uniforms.sunDir.value.copy(_sunDir);
 skyMat.uniforms.uDiscIn.value=sr>0?Math.cos(sr):2;
 skyMat.uniforms.uDiscOut.value=sr>0?Math.cos(sr*1.7):2;
 skyMat.uniforms.uGlow.value=lerp(A.glow,B.glow,w);
 scene.fog.color.copy(PAL.fog);
 scene.fog.far=lerp(A.fogFar,B.fogFar,w);
 hemi.color.copy(PAL.hemiS); hemi.groundColor.copy(PAL.hemiG);
 moonLight.intensity=lerp(A.moonI,B.moonI,w);
 starMat.opacity=lerp(A.stars,B.stars,w)*0.9;
 dash.userData.accent.material.color.copy(PAL.accent);
 document.documentElement.style.setProperty('--ac','#'+PAL.accent.getHexString());
 edgeLM.material.color.copy(PAL.edge); edgeRM.material.color.copy(PAL.edge);
 edgeLM.material.opacity=lerp(A.edgeO,B.edgeO,w)*0.5;
 edgeRM.material.opacity=edgeLM.material.opacity;
 const dom=(w>0.5?ZR[nk][2]:kr[2]);
 if(dom!==domZone){
  domZone=dom;
  audio.setChord(ZONES[dom].pad);
  if(state==='race'){
   flashScreen(0.14);
   showCard(ZONES[dom].num,ZONES[dom].name);
  }
 }
 if(state==='race'||state==='countdown'){
  const g=gates[P.nextGate-1];
  if(g) g.mats[0].color.copy(g.accent).lerp(_pulseC.setHex(0xffffff),0.25+0.25*Math.sin(time*7));
 }
 const inTunnel=(P.t>0.628&&P.t<0.712);
 const headTgt=inTunnel?1.8:lerp(A.head,B.head,w);
 headCur=damp(headCur,headTgt,3,dt);
 headSpot.intensity=headCur*2.0;
 coneMat.opacity=headCur*0.05;
 headGlowMat.opacity=0.12+headCur*0.22;
 headWetMat.opacity=wet*0.22*clamp(Math.abs(P.vF)/MAXV,0,1);
}

/* ================= ENV ANIMATION + MUSIC ================= */
const BPM=96;
let beatClock=0;
function stepEnv(dt){
 beatClock+=dt*BPM/60;
 const beat=beatClock%1;
 const pulse=Math.pow(1-beat,3);
 const d1=Math.hypot(P.x-plazaPos.x,P.z-plazaPos.z);
 const d2=Math.hypot(P.x-stagePos.x,P.z-stagePos.z);
 const prox=Math.max(clamp(1-d1/140,0,1),clamp(1-d2/140,0,1));
 if((state==='race'||state==='title')&&prox>0.06){
  const bInt=Math.floor(beatClock);
  if(bInt!==audio._lastBeat){
   audio._lastBeat=bInt;
   audio.kick(0.22*prox);
   setTimeout(()=>audio.hat(0.05*prox),BPM/60*500);
  }
 }
 for(const bm of beams){
  if(bm.cone){
   bm.cone.rotation.z=Math.sin(time*0.7+bm.ph)*0.5;
   bm.cone.rotation.y=Math.cos(time*0.5+bm.ph)*0.4;
   bm.cone.material.opacity=bm.base+pulse*0.4*prox+0.05;
  }
 }
 if(beams.barMat) beams.barMat.color.copy(ZONES[2].cAccent).multiplyScalar(0.6+pulse*0.6*prox);
 for(const s of screens){
  s.t+=dt;
  if(s.t>4){ s.t=0; s.slide++; drawScreen(s); }
  s.mat.color.setScalar(0.82+pulse*0.3*prox);
 }
 for(const g of glowSprites)
  g.spr.material.opacity=g.base+pulse*g.beat*prox;
 for(const fl of flickers){
  const on=(Math.sin(time*23+fl.spr.position.x)>-0.7&&Math.random()>0.03)?1:0.15;
  fl.spr.material.opacity=fl.base*on;
 }
 for(const st of reflectStreaks) st.material.opacity=wet*0.34;
 for(const pm of poolMeshes) pm.im.material.opacity=pm.base+wet*0.13;
 studMesh.material.color.setHex(0xfff0cf).multiplyScalar(0.7+wet*1.1);
 for(const c of crowds){
  for(let k=0;k<c.items.length;k++){
   const it=c.items[k];
   dummy.position.set(it.x+Math.sin(time*1.4+it.ph)*0.16,
    it.y+0.55*it.sy+Math.sin(time*2+it.ph)*0.03,
    it.z+Math.cos(time*1.1+it.ph)*0.12);
   dummy.rotation.set(0,it.r,Math.sin(time*2+it.ph)*0.05);
   dummy.scale.set(1,it.sy,1);
   dummy.updateMatrix(); c.im.setMatrixAt(k,dummy.matrix);
  }
  c.im.instanceMatrix.needsUpdate=true;
 }
 for(const b of banners) b.flag.rotation.y=Math.sin(time*1.6+b.ph)*0.24;
 for(const v of steamVents){
  if(Math.random()<0.06&&Math.hypot(v.x-P.x,v.z-P.z)<90)
   smoke.spawn(new THREE.Vector3(v.x+rand(-0.5,0.5),v.y+0.4,v.z+rand(-0.5,0.5)),
    new THREE.Vector3(rand(-0.3,0.3),rand(1.2,2),rand(-0.3,0.3)),rand(1.2,2),rand(1,1.8),0x3c4048,2.4);
 }
 for(const b of blinkers) b.s.material.opacity=((time+b.ph)%1.4<0.12)?0.9:0;
 for(const t of trafficDots){
  t.a+=dt*0.01*t.dir;
  t.s.position.set(Math.cos(t.a)*t.r,1.2,Math.sin(t.a)*t.r);
 }
 if(craneBlink) craneBlink.material.opacity=((time%1.6)<0.15)?0.9:0.05;
 const cyc=(time%9);
 signalHeads.forEach(h=>{
  h['#ff4040'].material.opacity=(cyc>5)?0.95:0.15;
  h['#ffd23f'].material.opacity=(cyc>4.2&&cyc<=5)?0.95:0.12;
  h['#3dff7a'].material.opacity=(cyc<=4.2)?0.95:0.12;
 });
 if(ovLights){
  ovLights.u=(ovLights.u+dt*0.06)%1.2;
  const off=(ovLights.u-0.1)*150;
  ovLights.p1.position.set(ovLights.c0.x+ovLights.dir.x*off,ovLights.deckY+0.9,ovLights.c0.z+ovLights.dir.z*off);
  ovLights.p2.position.set(ovLights.c0.x-ovLights.dir.x*(off-24),ovLights.deckY+0.9,ovLights.c0.z-ovLights.dir.z*(off-24));
 }
 exhaustMat.opacity=(inThrottle()>0?0.12:0)+P.rpm*0.15;
 underMat.color.copy(PAL.accent);
 underMat.opacity=0.08+(P.nitroOn?0.3:0)+(P.drifting?0.1:0);
 rig.position.set(P.x,carY,P.z); rig.rotation.y=P.h;
 playerShadow.position.set(P.x,carY+0.05,P.z);
 playerShadow.rotation.y=P.h;
 const spN=clamp(Math.hypot(P.vx,P.vz)/MAXV,0,1.2);
 $('streaks').style.opacity=((spN>0.72||P.nitroOn)&&state==='race')?(P.nitroOn?0.5:0.3):0;
}

/* ================= GAUGES / HUD ================= */
function dial(cx,cy,r,frac,label,redFrom,acc){
 const c=gaugeCtx, a0=Math.PI*0.75, a1=Math.PI*2.25;
 c.beginPath(); c.arc(cx,cy,r,0,7); c.fillStyle='#0a0b10'; c.fill();
 c.lineWidth=2; c.strokeStyle='rgba(255,255,255,.16)'; c.stroke();
 if(redFrom){ c.beginPath(); c.arc(cx,cy,r-7,a0+(a1-a0)*redFrom,a1);
  c.lineWidth=5; c.strokeStyle='#ff4b4b'; c.stroke(); }
 for(let k=0;k<=10;k++){
  const an=a0+(a1-a0)*k/10;
  c.beginPath(); c.moveTo(cx+Math.cos(an)*(r-5),cy+Math.sin(an)*(r-5));
  c.lineTo(cx+Math.cos(an)*(r-12),cy+Math.sin(an)*(r-12));
  c.lineWidth=k%5===0?2.5:1; c.strokeStyle='rgba(255,255,255,.4)'; c.stroke();
 }
 const an=a0+(a1-a0)*clamp(frac,0,1.02);
 c.beginPath(); c.moveTo(cx-Math.cos(an)*12,cy-Math.sin(an)*12);
 c.lineTo(cx+Math.cos(an)*(r-14),cy+Math.sin(an)*(r-14));
 c.lineWidth=3.5; c.lineCap='round'; c.strokeStyle=acc; c.stroke();
 c.beginPath(); c.arc(cx,cy,5,0,7); c.fillStyle=acc; c.fill();
 c.fillStyle='rgba(255,255,255,.45)'; c.font='500 9px "Space Grotesk", sans-serif'; c.textAlign='center';
 c.fillText(label,cx,cy+r*0.55);
}
function drawGauges(acc){
 const kmh=Math.abs(P.vF)*3.6;
 gaugeCtx.clearRect(0,0,360,180);
 dial(90,96,64,kmh/220,'KM/H',0,acc);
 dial(270,96,64,P.rpm,'RPM',0.79,acc);
 gaugeCtx.fillStyle='#eef0f4'; gaugeCtx.font='700 30px "Space Grotesk", sans-serif'; gaugeCtx.textAlign='center';
 const gt=(P.mode==='R'&&P.vF<-0.3)?'R':(Math.abs(P.vF)<0.4?'N':P.gear);
 gaugeCtx.fillText(gt,180,168);
 gaugeCtx.fillStyle='rgba(255,255,255,.3)'; gaugeCtx.font='500 9px "Space Grotesk", sans-serif';
 gaugeCtx.fillText('L U C I D   N I G H T S',180,24);
 gaugeTex.needsUpdate=true;
}
const mm=$('minimap').getContext('2d');
let mmB=null, mmPath=null;
{
 let mnx=1e9,mxx=-1e9,mnz=1e9,mxz=-1e9;
 for(const p of SP){mnx=Math.min(mnx,p.x);mxx=Math.max(mxx,p.x);mnz=Math.min(mnz,p.z);mxz=Math.max(mxz,p.z);}
 const pad=12, s=(150-pad*2)/Math.max(mxx-mnx,mxz-mnz);
 mmB={mnx,mnz,s,ox:(150-(mxx-mnx)*s)/2,oz:(150-(mxz-mnz)*s)/2};
 mmPath=new Path2D();
 for(let i=0;i<=N;i+=10){
  const p=SP[i%N];
  const x=(p.x-mmB.mnx)*mmB.s+mmB.ox, y=(p.z-mmB.mnz)*mmB.s+mmB.oz;
  i===0?mmPath.moveTo(x,y):mmPath.lineTo(x,y);
 }
}
function drawMinimap(){
 mm.clearRect(0,0,150,150);
 mm.lineWidth=3; mm.strokeStyle='rgba(255,255,255,.32)'; mm.stroke(mmPath);
 const accC=getComputedStyle(document.documentElement).getPropertyValue('--ac').trim();
 for(let k=1;k<=10;k++){
  const p=SP[Math.floor(k/10*N)%N];
  const x=(p.x-mmB.mnx)*mmB.s+mmB.ox, y=(p.z-mmB.mnz)*mmB.s+mmB.oz;
  const passed=k<P.nextGate;
  mm.beginPath(); mm.arc(x,y,passed?2:2.6,0,7);
  mm.fillStyle=passed?'rgba(255,255,255,.3)':(k===P.nextGate?accC:'rgba(255,255,255,.8)');
  mm.fill();
 }
 for(const a of ais){
  const x=(a.mesh.position.x-mmB.mnx)*mmB.s+mmB.ox, y=(a.mesh.position.z-mmB.mnz)*mmB.s+mmB.oz;
  mm.beginPath(); mm.arc(x,y,2.6,0,7); mm.fillStyle='#'+new THREE.Color(a.color).getHexString(); mm.fill();
 }
 const px=(P.x-mmB.mnx)*mmB.s+mmB.ox, py=(P.z-mmB.mnz)*mmB.s+mmB.oz;
 mm.save(); mm.translate(px,py);
 mm.rotate(Math.atan2(Math.sin(P.h),-Math.cos(P.h))+Math.PI);
 mm.beginPath(); mm.moveTo(0,-6.5); mm.lineTo(4.6,5.2); mm.lineTo(-4.6,5.2); mm.closePath();
 mm.fillStyle='#fff'; mm.fill(); mm.strokeStyle=accC; mm.lineWidth=1.5; mm.stroke();
 mm.restore();
}
const STAR='M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8-6.1-3.4-6.1 3.4 1.4-6.8L2.2 9.1l6.9-.8z';
function starSVG(fill){return '<svg viewBox="0 0 24 24"><path d="'+STAR+'" fill="'+(fill?'var(--ac)':'none')+'" stroke="'+(fill?'var(--ac)':'rgba(255,255,255,.3)')+'" stroke-width="1.4"/></svg>';}
function stepHUD(){
 $('speedNum').textContent=Math.round(Math.abs(P.vF)*3.6);
 $('gear').textContent=(P.mode==='R'&&P.vF<-0.3)?'R':(Math.abs(P.vF)<0.4&&inThrottle()===0?'N':P.gear);
 const rn=P.rpm;
 const rpmI=$('rpm'); rpmI.querySelector('i').style.width=(rn*100)+'%';
 rpmI.classList.toggle('hot',rn>0.93);
 $('nitro').querySelector('i').style.width=(P.nitro*100)+'%';
 $('hTime').textContent=fmtT(raceTime);
 $('hLap').textContent=Math.min(P.lapsDone+1,2)+'/2';
 $('hGate').textContent=P.nextGate+'/10';
 const pm=playerMeters();
 let pos=1; for(const a of ais) if(a.s>pm) pos++;
 $('hPos').textContent=pos+'/4';
 const elev=Math.round(carY);
 $('altLab').textContent='ELEV '+(elev>=0?'+':'')+elev+' M · '+CLS_NAMES[CLS[P.pIdx]];
 if(P.chain>40){ $('driftPop').classList.add('on'); $('driftVal').textContent='+'+Math.round(P.chain); }
 else $('driftPop').classList.remove('on');
 drawMinimap();
 drawGauges('#'+PAL.accent.getHexString());
}

/* ================= RESULTS ================= */
function showResults(){
 resultsShown=true;
 const par=2*L, s3=par/24.5, s2=par/20.5;
 const stars=raceTime<=s3?3:(raceTime<=s2?2:1);
 const pm=playerMeters();
 const rows=[{name:'YOU',m:pm,you:true,time:raceTime,fin:true}]
  .concat(ais.map(a=>({name:a.name,m:a.s,you:false,time:a.time,fin:a.finished})))
  .sort((a,b)=>(b.fin?b.m:-1e9)-(a.fin?a.m:-1e9));
 const place=rows.findIndex(r=>r.you)+1;
 const suf=['ST','ND','RD','TH'][place-1]||'TH';
 $('rPlace').textContent=place+suf+' PLACE';
 $('rStars').innerHTML=[1,2,3].map(i=>starSVG(i<=stars)).join('');
 $('rTime').textContent=fmtT(raceTime);
 $('rBest').textContent=lapTimes.length?fmtT(Math.min.apply(null,lapTimes)):'—';
 $('rTop').textContent=Math.round(topSpeed)+' KM/H';
 $('rDrift').textContent=Math.round(driftTotal+P.chain);
 $('rDmg').textContent=Math.round(P.dmg)+'%';
 $('rBoard').innerHTML=rows.map((r,i)=>
  '<div class="row '+(r.you?'you':'')+'"><span>'+(i+1)+'. '+r.name+'</span><span>'+(r.fin?fmtT(r.time):'racing…')+'</span></div>').join('');
 const prev=store.get('lucid.best');
 let newBest=false;
 if(prev){ try{ if(raceTime<+JSON.parse(prev).t) newBest=true; }catch(e){ newBest=true; } } else newBest=true;
 if(newBest) store.set('lucid.best',JSON.stringify({t:raceTime,s:stars}));
 $('newBest').classList.toggle('on',newBest);
 setTouchVisible(false);
 showScreen('results');
}

/* ================= ZONE DEBUG (B) ================= */
try{
 (function buildDebugBands(){
  function band(a0F,a1F,color){
   const pos=[];
   for(let i=0;i<N;i++){
    const iN=(i+1)%N;
    const A=a0F(i), B=a1F(i), A2=a0F(iN), B2=a1F(iN);
    if(B-A<0.25) continue;
    const P1=new THREE.Vector3().copy(SP[i]).addScaledVector(SR[i],A);
    const P2=new THREE.Vector3().copy(SP[i]).addScaledVector(SR[i],B);
    const P3=new THREE.Vector3().copy(SP[iN]).addScaledVector(SR[iN],B2);
    const P4=new THREE.Vector3().copy(SP[iN]).addScaledVector(SR[iN],A2);
    for(const v of [P1,P2,P3,P1,P3,P4]){ pos.push(v.x,v.y+0.2,v.z); }
   }
   if(!pos.length) return;
   const g=new THREE.BufferGeometry();
   g.setAttribute('position',new THREE.BufferAttribute(new Float32Array(pos),3));
   const mesh=new THREE.Mesh(g,new THREE.MeshBasicMaterial({color,transparent:true,opacity:0.3,
    depthWrite:false,toneMapped:false,side:THREE.DoubleSide}));
   mesh.renderOrder=4; mesh.visible=false;
   scene.add(mesh); dbgMeshes.push(mesh);
  }
  band(i=>-HW[i],i=>HW[i],0x27e06a);
  band(i=>HW[i],i=>HW[i]+CURB_W,0xe0c72a);
  band(i=>-(HW[i]+CURB_W),i=>-HW[i],0xe0c72a);
  band(i=>HW[i]+CURB_W,i=>HW[i]+CURB_W+WALK[i],0x3aa0ff);
  band(i=>-(HW[i]+CURB_W+WALK[i]),i=>-(HW[i]+CURB_W),0x3aa0ff);
 })();
}catch(e){ console.warn('[LUCID] debug bands skipped:',e&&e.message); }

/* ================= VALIDATION REPORT ================= */
try{
 (function runValidation(){
  let bad=0, worst=0, worstDesc='';
  obstacles.forEach((o,i)=>{
   const n=nearestSample(o.x,o.z);
   const min=HW[n.i]+o.pad;
   if(n.d<min-0.05){
    bad++;
    if(min-n.d>worst){ worst=min-n.d; worstDesc='obstacle #'+i; }
   }
  });
  console.log('%c[LUCID NIGHTS BUILD '+window.BUILD+'] ROUTE VALIDATION','color:#5ad0ff;font-weight:bold');
  console.log('  route length:',(L/1000).toFixed(2)+' km · max elevation 21 m');
  console.log('  obstacles checked:',obstacles.length);
  console.log('  road-space violations:',bad, bad===0?'— ROUTE IS CLEAR ✓':'');
  if(bad>0) console.warn('  worst intrusion:',worst.toFixed(2)+'m at '+worstDesc);
 })();
}catch(e){ console.warn('[LUCID] validation skipped:',e&&e.message); }

/* ================= MAIN LOOP ================= */
const clock=new THREE.Clock();
if(screens[0]) drawScreen(screens[0]);
function frame(){
 requestAnimationFrame(frame);
 const dt=Math.min(clock.getDelta(),0.05);
 try{
 if(!paused){
  time+=dt;
  if(state==='title'){
   autopilot(dt,15);
   audio.engine(P.rpm,0,0.1); audio.wind(0); audio.skid(0);
  }else if(state==='countdown'){
   cdT+=dt;
   const steps=[[0.5,'3'],[1.5,'2'],[2.5,'1']];
   while(cdStep<3&&cdT>=steps[cdStep][0]){
    popCountdown(steps[cdStep][1]); audio.count(false); cdStep++;
   }
   if(cdT>=3.5){
    popCountdown('GO','#ffffff'); audio.count(true); flashScreen(0.2);
    state='race'; raceTime=0;
    showCard('LUCID NIGHTS PRESENTS','MIDNIGHT PULSE · GRAND LOOP');
   }
   audio.engine(inThrottle()*0.85+0.1,inThrottle(),0);
   audio.wind(0); audio.skid(0);
  }else if(state==='race'){
   raceTime+=dt;
   stepPlayer(dt);
   stepProgress();
   stepAI(dt);
   const spN=clamp(Math.hypot(P.vx,P.vz)/MAXV,0,1.2);
   audio.engine(P.rpm,inThrottle(),spN);
   audio.wind(spN);
   audio.skid(P.drifting?Math.min(1,Math.abs(P.slip)*2.4):0);
  }else if(state==='finished'){
   finishT+=dt;
   P.vx*=Math.exp(-dt*0.8); P.vz*=Math.exp(-dt*0.8);
   P.x+=P.vx*dt; P.z+=P.vz*dt;
   P.vF=Math.hypot(P.vx,P.vz);
   audio.engine(0.15,0,0.1); audio.wind(0); audio.skid(0);
   if(finishT>1.5&&!resultsShown) showResults();
  }
  stepWeather(dt);
  stepPalette(dt);
  stepEnv(dt);
  stepCamera(dt);
  smoke.update(dt); sparks.update(dt);
  if(state!=='title') stepHUD();
 }
 }catch(err){
  if(!window.__frameErr){ window.__frameErr=1; __fatal('Runtime error: '+(err&&err.message?err.message:err),err); }
 }
 renderer.render(scene,camera);
}
frame();

addEventListener('resize',()=>{
 camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

}catch(err){
 __fatal('Startup error: '+(err&&err.message?err.message:err),err);
 if(console.error) console.error(err);
}
})();
