 wind(spN){ if(!this.ok)return; const t=this.ctx.currentTime;
  this.wGain.gain.setTargetAtTime(spN*spN*0.5,t,0.12);
  this.wFilt.frequency.setTargetAtTime(300+spN*900,t,0.2); },
