   this.shaper.curve=curveA; this.shaper.oversample='2x';
   const bass=ctx.createBiquadFilter(); bass.type='lowshelf'; bass.frequency.value=140; bass.gain.value=7;
   const pres=ctx.createBiquadFilter(); pres.type='peaking'; pres.frequency.value=1500; pres.Q.value=1; pres.gain.value=3;
   this.oscA=ctx.createOscillator(); this.oscA.type='sawtooth';
   this.oscB=ctx.createOscillator(); this.oscB.type='sawtooth';
   this.oscC=ctx.createOscillator(); this.oscC.type='sine';
   this.oscD=ctx.createOscillator(); this.oscD.type='square';
   const gA=ctx.createGain(); gA.gain.value=0.5;
   const gB=ctx.createGain(); gB.gain.value=0.4;
   const gC=ctx.createGain(); gC.gain.value=0.85;
   this.gD=ctx.createGain(); this.gD.gain.value=0;
   this.oscA.connect(gA); this.oscB.connect(gB); this.oscC.connect(gC); this.oscD.connect(this.gD);
   gA.connect(this.shaper); gB.connect(this.shaper); gC.connect(this.shaper); this.gD.connect(this.shaper);
   this.shaper.connect(bass); bass.connect(this.eFilt); this.eFilt.connect(pres); pres.connect(this.eGain);
   this.eGain.connect(this.master);
   const inN=ctx.createBufferSource(); inN.buffer=buf; inN.loop=true;
   this.iFilt=ctx.createBiquadFilter(); this.iFilt.type='bandpass'; this.iFilt.frequency.value=900; this.iFilt.Q.value=0.8;
   this.iGain=ctx.createGain(); this.iGain.gain.value=0;
   inN.connect(this.iFilt); this.iFilt.connect(this.iGain); this.iGain.connect(this.eFilt);
   inN.start();
   this.oscA.start(); this.oscB.start(); this.oscC.start(); this.oscD.start();
   this.tOsc=ctx.createOscillator(); this.tOsc.type='sine'; this.tOsc.frequency.value=1400;
